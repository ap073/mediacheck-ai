# MediaCheck AI Environment Configuration
# Copy this file to .env before starting the backend API

# -------------------------------------------------------------
# Sightengine API Credentials
# Obtain from https://sightengine.com/ (Free & Paid tiers)
# -------------------------------------------------------------
SIGHTENGINE_API_USER=your_sightengine_api_user_here
SIGHTENGINE_API_SECRET=your_sightengine_api_secret_here

# -------------------------------------------------------------
# Backend Service Configuration
# -------------------------------------------------------------
API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","chrome-extension://*"]

# -------------------------------------------------------------
# Analysis Limits
# -------------------------------------------------------------
MAX_IMAGE_SIZE_MB=20
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=60
RATE_LIMIT_PER_MINUTE=60
REQUEST_TIMEOUT_SECONDS=45.0

# -------------------------------------------------------------
# Frontend Configuration (apps/web/.env.local)
# -------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
